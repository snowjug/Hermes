: 86.12}, {"w": "data", "start": 86.12, "end": 86.37}, {"w": "can", "start": 86.37, "end": 86.52}, {"w": "be", "start": 86.52, "end": 86.68}, {"w": "delayed,", "start": 86.68, "end": 87.12}, {"w": "incomplete", "start": 87.42, "end": 88.02}, {"w": "or", "start": 88.11, "end": 88.34}, {"w": "wrong,", "start": 88.34, "end": 88.64}, {"w": "so", "start": 89.08, "end": 89.24}, {"w": "it's", "start": 89.24, "end": 89.42}, {"w": "not", "start": 89.42, "end": 89.6}, {"w": "for", "start": 89.6, "end": 89.76}, {"w": "navigation", "start": 89.76, "end": 90.4}, {"w": "or", "start": 90.4, "end": 90.62}, {"w": "emergencies.", "start": 90.62, "end": 91.13}]}, {"text": "Traffic is simulated, camera angles are estimates, and the 3D cities need a key.", "start": 91.82, "end": 96.64, "words": [{"w": "Traffic", "start": 91.82, "end": 92.19}, {"w": "is", "start": 92.19, "end": 92.42}, {"w": "simulated,", "start": 92.42, "end": 92.85}, {"w": "camera", "start": 93.3, "end": 93.68}, {"w": "angles", "start": 93.68, "end": 94.0}, {"w": "are", "start": 94.0, "end": 94.14}, {"w": "estimates,", "start": 94.14, "end": 94.76}, {"w": "and", "start": 94.97, "end": 95.26}, {"w": "the", "start": 95.26, "end": 95.46}, {"w": "3D", "start": 95.46, "end": 95.68}, {"w": "cities", "start": 95.68, "end": 96.08}, {"w": "need", "start": 96.08, "end": 96.28}, {"w": "a", "start": 96.28, "end": 96.34}, {"w": "key.", "start": 96.34, "end": 96.64}]}, {"text": "And by design, it won't do face recognition or track individual people.", "start": 97.54, "end": 101.55, "words": [{"w": "And", "start": 97.54, "end": 97.7}, {"w": "by", "start": 97.7, "end": 97.88}, {"w": "design,", "start": 97.88, "end": 98.43}, {"w": "it", "start": 98.53, "end": 98.7}, {"w": "won't", "start": 98.7, "end": 98.92}, {"w": "do", "start": 98.92, "end": 99.18}, {"w": "face", "start": 99.18, "end": 99.46}, {"w": "recognition", "start": 99.46, "end": 100.24}, {"w": "or", "start": 100.24, "end": 100.4}, {"w": "track", "start": 100.4, "end": 100.7}, {"w": "individual", "start": 100.7, "end": 101.25}, {"w": "people.", "start": 101.25, "end": 101.55}]}, {"text": "All of this data was already public. It's just never been this easy to see it all at once.", "start": 102.03, "end": 106.9, "words": [{"w": "All", "start": 102.03, "end": 102.26}, {"w": "of", "start": 102.26, "end": 102.34}, {"w": "this", "start": 102.34, "end": 102.56}, {"w": "data", "start": 102.56, "end": 102.84}, {"w": "was", "start": 102.84, "end": 102.99}, {"w": "already", "start": 103.08, "end": 103.53}, {"w": "public.", "start": 103.53, "end": 103.85}, {"w": "It's", "start": 104.43, "end": 104.6}, {"w": "just", "start": 104.6, "end": 104.82}, {"w": "never", "start": 104.82, "end": 105.04}, {"w": "been", "start": 105.04, "end": 105.2}, {"w": "this", "start": 105.2, "end": 105.43}, {"w": "easy", "start": 105.43, "end": 105.82}, {"w": "to", "start": 105.82, "end": 105.98}, {"w": "see", "start": 105.98, "end": 106.16}, {"w": "it", "start": 106.16, "end": 106.26}, {"w": "all", "start": 106.26, "end": 106.48}, {"w": "at", "start": 106.48, "end": 106.74}, {"w": "once.", "start": 106.74, "end": 106.9}]}, {"text": "That's God's Eye View. Free, open source, and a little bit terrifying.", "start": 107.89, "end": 112.53, "words": [{"w": "That's", "start": 107.89, "end": 108.34}, {"w": "God's", "start": 108.34, "end": 108.76}, {"w": "Eye", "start": 108.76, "end": 108.9}, {"w": "View.", "start": 108.9, "end": 109.12}, {"w": "Free,", "start": 109.64, "end": 110.04}, {"w": "open", "start": 110.25, "end": 110.6}, {"w": "source,", "start": 110.6, "end": 111.01}, {"w": "and", "start": 111.32, "end": 111.54}, {"w": "a", "start": 111.54, "end": 111.66}, {"w": "little", "start": 111.66, "end": 111.92}, {"w": "bit", "start": 111.92, "end": 112.03}, {"w": "terrifying.", "start": 112.03, "end": 112.53}]}, {"text": "Subscribe, there's a new tool every day.", "start": 113.05, "end": 115.51, "words": [{"w": "Subscribe,", "start": 113.05, "end": 113.65}, {"w": "there's", "